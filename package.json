{
  "name": "the-wrong-floor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Five-minute first-person observation-horror vertical slice",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs",
    "validate": "node scripts/validate-project.mjs && node scripts/migration-manifest.mjs --check",
    "test": "node --test tests/*.test.mjs desktop/tests/*.test.mjs && npm run validate && node desktop/stage.mjs && node desktop/validate-stage.mjs",
    "test:browser": "node tests/browser-smoke.mjs --smoke",
    "review:full": "node tests/browser-smoke.mjs --full",
    "package:web": "node scripts/build-site.mjs && node scripts/archive-release.mjs web",
    "package:windows": "npm --prefix desktop run package:windows",
    "package:mac": "npm --prefix desktop run package:mac",
    "package:linux": "npm --prefix desktop run package:linux"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
